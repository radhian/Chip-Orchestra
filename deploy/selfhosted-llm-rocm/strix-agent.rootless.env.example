# Strix Halo env — ROOTLESS Podman (no sudo) variant.
# Run with BOTH the base file and the rootless override:
#   podman-compose --env-file strix-agent.rootless.env \
#     -f docker-compose.strix-full.yml -f docker-compose.strix-full.rootless.yml up -d --build
#
# Why rootless needs a compose override too (unlike R9700 core): the GLM server
# needs GPU device access. Under rootless, the safest way to keep access to the
# host /dev/dri render node is `group_add: [keep-groups]` (so the container keeps
# your real supplementary groups). That change lives in docker-compose.strix-full.rootless.yml.
#
# Differences vs strix-agent.env.example:
#   * AGENT_BIND_HOST=0.0.0.0 (rootless cannot bind the fixed LAN IP).
#   * WORKSPACE/MODEL paths under your HOME, not /srv or /data (no root needed).
#     Set ABSOLUTE paths — env-file values are not shell-expanded, so no ${HOME}.
#     If you keep the /home/YOUR_USER placeholders, ./scripts/prepare_host.sh will
#     auto-patch them to your real $HOME.

COMPOSE_PROJECT_NAME=chip-orchestra-strix

R9700_HOST=172.16.1.36
STRIX_HALO_HOST=172.16.1.10
AGENT_BIND_HOST=0.0.0.0
AGENT_PORT=8001

MYSQL_DATABASE=chip_orchestra
MYSQL_USER=chip
MYSQL_PASSWORD=chip
MYSQL_PORT=3306
REDIS_PORT=6379

DEFAULT_USERNAME=admin
DEFAULT_FULL_NAME=Radhian Ferel Armansyah

# Shared workspace under your HOME (absolute path, no ${HOME}); must be the same
# data the R9700 node sees (share over NFS if the two hosts are separate).
WORKSPACE_HOST_PATH=/home/YOUR_USER/chip-orchestra/workspaces
WORKSPACE_ROOT=/srv/chip-orchestra/workspaces
AGENT_ARTIFACT_ROOT=/srv/chip-orchestra/workspaces

# On SELinux-enforcing hosts, relabel the bind mount for the container.
# WORKSPACE_MOUNT_FLAG=:z

# --- LLM: GLM co-located with agent-service on Strix Halo ---
LLM_PROVIDER=glm
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=GLM-5.2
OPENAI_BASE_URL=http://glm-server:10000/v1

# --- GLM model server (llama.cpp-ROCm, gfx1151 / Strix Halo iGPU) ---
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm
HSA_OVERRIDE_GFX_VERSION=11.5.1
# Keep the in-container GLM port stable for agent-service; change only the host
# bind port if :10000 is already occupied on Strix Halo.
LLM_HOST_PORT=10001
LLM_SERVE_PORT=10000
LLM_CTX=32768
NGL=999
# Model cache under $HOME (absolute path, no ${HOME}); /data needs root.
MODEL_DIR=/home/YOUR_USER/chip-orchestra/models
# Pick a GGUF that fits Strix Halo unified memory (see GLM_SELFHOST_AMD.md).
# Full flagship GLM-5.2 (~750B) does NOT fit one node — use a smaller GLM or a cluster.
GLM_MODEL_REPO=unsloth/GLM-4.5-Air-GGUF
GLM_MODEL_FILE=GLM-4.5-Air-Q4_K_M.gguf

AGENT_DEEP_AGENTS=1
GARUDA_DEEP_BUDGET_S=2400
GARUDA_PY_TIMEOUT_S=600
AGENT_WEB_RESEARCH=1
GARUDA_RESEARCH_BUDGET_S=420
GARUDA_CLONE_TIMEOUT_S=90
MAX_REPAIR_ITERS=3
