# R9700 core stack env — ROOTLESS Podman (no sudo) variant.
# Run with:
#   podman-compose --env-file r9700-core.rootless.env -f docker-compose.r9700-core.yml up -d --build
#
# Differences vs r9700-core.env.example (why rootless needs them):
#   * Bind hosts are 0.0.0.0, not 172.16.1.36. Rootless Podman cannot bind a
#     specific non-loopback host IP ("cannot assign requested address"); 0.0.0.0
#     works and still exposes the ports on the LAN IP for cross-node access.
#   * WORKSPACE paths live under your HOME, not /srv (which needs root to create).
#     Set an ABSOLUTE path here — env-file values are not shell-expanded, so do
#     NOT use ${HOME}. Replace /home/radhian.armansyah below with your real HOME.

COMPOSE_PROJECT_NAME=chip-orchestra-r9700

R9700_HOST=172.16.1.36
STRIX_HALO_HOST=172.16.1.10
MYSQL_BIND_HOST=0.0.0.0
REDIS_BIND_HOST=0.0.0.0
EDA_BIND_HOST=0.0.0.0

MYSQL_DATABASE=chip_orchestra
MYSQL_USER=chip
MYSQL_PASSWORD=chip
MYSQL_ROOT_PASSWORD=chiproot
MYSQL_PORT=3306
REDIS_PORT=6379

OPERATOR_PORT=8080
EDA_PORT=8002
FRONTEND_PORT=4173
JWT_SECRET=chip-orchestra-secret
DEFAULT_USERNAME=admin
DEFAULT_FULL_NAME=Radhian Ferel Armansyah
DEFAULT_EMAIL=radhian.armansyah@bytedance.com
DEFAULT_PASSWORD=chip-orchestra

# Orchestrator calls remote agent-service on Strix Halo.
AGENT_SERVICE_URL=http://172.16.1.10:8001

# Shared workspace under your HOME (absolute path, no ${HOME}).
# Must match on both hosts if you share it over NFS.
WORKSPACE_HOST_PATH=/home/radhian.armansyah/chip-orchestra/workspaces
WORKSPACE_ROOT=/srv/chip-orchestra/workspaces
AGENT_ARTIFACT_ROOT=/srv/chip-orchestra/workspaces
# On SELinux-enforcing hosts, relabel the bind mount for the container:
# WORKSPACE_MOUNT_FLAG=:z

PDK_ROOT=/opt/pdk
PDK=gf180mcuD
GF180_VOLTAGE=3v3
EDA_JOB_TIMEOUT_SIM=600
EDA_JOB_TIMEOUT_HARDEN=3600
EDA_JOB_TIMEOUT_STA=900
EDA_JOB_TIMEOUT_GL_SIM=900

AGENT_INVOKE_TIMEOUT_SECONDS=1800
SIM_AUTO_REPAIR_ROUNDS=10
HARDEN_AUTO_REPAIR_ROUNDS=3

# Browsers still reach the orchestrator on the LAN IP.
VITE_API_BASE_URL=http://172.16.1.36:8080
