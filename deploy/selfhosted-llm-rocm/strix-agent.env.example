# Strix Halo env: agent-service + co-located GLM-5.2 model server.
# PRIMARY tool for the AMD path is Podman:
#   sudo podman-compose --env-file strix-agent.env -f docker-compose.strix-full.yml up -d
# Docker alternative:
#   docker compose --env-file strix-agent.env -f docker-compose.strix-full.yml up -d --build
#
# Use docker-compose.strix-agent.yml (agent only) if the model is hosted elsewhere.

COMPOSE_PROJECT_NAME=chip-orchestra-strix

R9700_HOST=172.16.1.36
STRIX_HALO_HOST=172.16.1.10
AGENT_BIND_HOST=172.16.1.10
AGENT_PORT=8001

MYSQL_DATABASE=chip_orchestra
MYSQL_USER=chip
MYSQL_PASSWORD=chip
MYSQL_PORT=3306
REDIS_PORT=6379

DEFAULT_USERNAME=admin
DEFAULT_FULL_NAME=Radhian Ferel Armansyah

# Shared workspace must be mounted at the same path used by R9700.
WORKSPACE_HOST_PATH=/srv/chip-orchestra/workspaces
WORKSPACE_ROOT=/srv/chip-orchestra/workspaces
AGENT_ARTIFACT_ROOT=/srv/chip-orchestra/workspaces

# Podman/SELinux only: set to ":z" so bind mounts are relabeled. Leave empty for Docker.
WORKSPACE_MOUNT_FLAG=

# --- LLM: GLM co-located with agent-service on Strix Halo ---
LLM_PROVIDER=glm
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=GLM-5.2
# Co-located default (strix-full.yml): reach GLM by compose service name.
OPENAI_BASE_URL=http://glm-server:10000/v1
# If running agent-only (strix-agent.yml) against a separate endpoint, use e.g.:
# OPENAI_BASE_URL=http://172.16.1.10:10000/v1

# --- GLM model server (llama.cpp-ROCm, gfx1151 / Strix Halo iGPU) ---
LLAMA_IMAGE=ghcr.io/kyuz0/amd-strix-halo-toolboxes:rocm-7rc-llama
HSA_OVERRIDE_GFX_VERSION=11.5.1
LLM_SERVE_PORT=10000
LLM_CTX=32768
NGL=999
MODEL_DIR=/data/models
# Pick a GGUF that fits Strix Halo unified memory (see GLM_SELFHOST_AMD.md).
# Full flagship GLM-5.2 (~750B) does NOT fit one node — use a smaller GLM or a cluster.
GLM_MODEL_REPO=unsloth/GLM-4.5-Air-GGUF
GLM_MODEL_FILE=GLM-4.5-Air-Q4_K_M.gguf

AGENT_DEEP_AGENTS=1
GARUDA_DEEP_BUDGET_S=2400
GARUDA_PY_TIMEOUT_S=600
AGENT_WEB_RESEARCH=1
GARUDA_RESEARCH_BUDGET_S=420
GARUDA_CLONE_TIMEOUT_S=90
MAX_REPAIR_ITERS=3
