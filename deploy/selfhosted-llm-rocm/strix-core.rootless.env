# Strix Halo single-node core stack env — ROOTLESS Podman (no sudo).
# Target host: 172.16.1.10
# Run core-only with:
#   podman-compose --env-file strix-core.rootless.env -f docker-compose.r9700-core.yml up -d --build
#
# Or run the full single-node stack against an EXTERNAL OpenAI-compatible LLM
# endpoint (default: the llama-swap already running on 172.16.1.10:10000):
#   podman-compose --env-file strix-core.rootless.env \
#     -f docker-compose.r9700-core.yml \
#     -f docker-compose.strix-full.yml \
#     -f docker-compose.strix-single-node.rootless.yml \
#     up -d --build
#
# To bring up the self-hosted GLM container instead (only after pre-downloading
# the ~68GB model — see scripts/download_glm_model.sh):
#   ./scripts/download_glm_model.sh strix-core.rootless.env
#   podman-compose --env-file strix-core.rootless.env \
#     -f docker-compose.r9700-core.yml \
#     -f docker-compose.strix-full.yml \
#     -f docker-compose.strix-single-node.rootless.yml \
#     --profile selfhosted-glm up -d --build
#   # and change OPENAI_BASE_URL / OPENAI_MODEL below to the self-hosted values.

COMPOSE_PROJECT_NAME=chip-orchestra-strix-single

R9700_HOST=172.16.1.10
STRIX_HALO_HOST=172.16.1.10
MYSQL_BIND_HOST=0.0.0.0
REDIS_BIND_HOST=0.0.0.0
EDA_BIND_HOST=0.0.0.0
AGENT_BIND_HOST=0.0.0.0

MYSQL_DATABASE=chip_orchestra
MYSQL_USER=chip
MYSQL_PASSWORD=chip
MYSQL_ROOT_PASSWORD=chiproot
MYSQL_PORT=3306
REDIS_PORT=6379

OPERATOR_PORT=8080
EDA_PORT=8002
FRONTEND_PORT=4173
AGENT_PORT=8001
JWT_SECRET=chip-orchestra-secret
DEFAULT_USERNAME=admin
DEFAULT_FULL_NAME=Radhian Ferel Armansyah
DEFAULT_EMAIL=radhian.armansyah@bytedance.com
DEFAULT_PASSWORD=chip-orchestra

# Everything is on Strix Halo, so the orchestrator calls local agent-service.
AGENT_SERVICE_URL=http://172.16.1.10:8001

# Rootless host paths must be absolute; env files do not expand ${HOME}.
WORKSPACE_HOST_PATH=/home/efison-radhi/chip-orchestra/workspaces
WORKSPACE_ROOT=/srv/chip-orchestra/workspaces
AGENT_ARTIFACT_ROOT=/srv/chip-orchestra/workspaces
# On SELinux-enforcing hosts, relabel the bind mount for the container:
# WORKSPACE_MOUNT_FLAG=:z

PDK_ROOT=/opt/pdk
PDK=gf180mcuD
GF180_VOLTAGE=3v3
EDA_JOB_TIMEOUT_SIM=600
EDA_JOB_TIMEOUT_HARDEN=3600
EDA_JOB_TIMEOUT_STA=900
EDA_JOB_TIMEOUT_GL_SIM=900

AGENT_INVOKE_TIMEOUT_SECONDS=1800
SIM_AUTO_REPAIR_ROUNDS=10
HARDEN_AUTO_REPAIR_ROUNDS=3

# Browsers reach the orchestrator on the Strix Halo LAN IP.
VITE_API_BASE_URL=http://localhost:8080

# Agent + GLM settings are included so this file can also drive the one-command
# full single-node compose invocation shown above.
#
# --- LLM backend selection ---
# DEFAULT: point agent-service at the external llama-swap server that is
# already running on the host at 172.16.1.10:10000. This lets the stack come
# up without waiting for the ~68GB self-hosted GLM download to complete.
# To switch to self-hosted GLM later:
#   1) run ./scripts/download_glm_model.sh strix-core.rootless.env
#   2) set OPENAI_BASE_URL=http://glm-server:10000/v1 and OPENAI_MODEL=GLM-5.2 below
#   3) start with --profile selfhosted-glm (see docker-compose.strix-full.yml header)
LLM_PROVIDER=glm
OPENAI_API_KEY=EMPTY
OPENAI_MODEL=Laguna-S-2.1
OPENAI_BASE_URL=http://172.16.1.10:10000/v1

LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-rocm
HSA_OVERRIDE_GFX_VERSION=11.5.1
# Keep the in-container GLM port stable for agent-service; publish it on a
# different host port because :10000 is commonly already occupied on Strix Halo.
LLM_HOST_PORT=10001
LLM_SERVE_PORT=10000
LLM_CTX=32768
NGL=999
MODEL_DIR=/home/efison-radhi/chip-orchestra/models
GLM_MODEL_REPO=unsloth/GLM-4.5-Air-GGUF
# Q4_K_M is ~73GB and stored as split GGUFs on Hugging Face. Point to shard 1;
# llama.cpp auto-loads sibling shards from the same directory at runtime.
GLM_MODEL_FILE=Q4_K_M/GLM-4.5-Air-Q4_K_M-00001-of-00002.gguf

# --- Offline model prerequisite ---
# glm-server passes `-hf ${GLM_MODEL_REPO}:${GLM_MODEL_FILE}` to llama-server.
# On hosts with restricted egress the HF fetch will fail and llama-server
# then tries the local `--model /models/${GLM_MODEL_FILE}` path. That local
# file MUST exist before starting the stack. Pre-download it once with:
#   ./scripts/download_glm_model.sh strix-core.rootless.env
# The file will be placed at ${MODEL_DIR}/${GLM_MODEL_FILE}.

# --- Optional fallback GLM base URL used only if in-network DNS fails ---
# When aardvark-dns is missing under rootless Podman, agent-service falls back
# to `glm-server:host-gateway` (see docker-compose.strix-single-node.rootless.yml),
# which reaches the GLM server via the host published port ${LLM_HOST_PORT}.
# The in-network preferred URL still uses the compose service name / container
# port and is unchanged: OPENAI_BASE_URL=http://glm-server:10000/v1


AGENT_DEEP_AGENTS=1
GARUDA_DEEP_BUDGET_S=2400
GARUDA_PY_TIMEOUT_S=600
AGENT_WEB_RESEARCH=1
GARUDA_RESEARCH_BUDGET_S=420
GARUDA_CLONE_TIMEOUT_S=90
MAX_REPAIR_ITERS=3
