# AMD infrastructure profile for Chip Orchestra.
# Copy this file to the repo-root .env when running the app stack, or source it
# before running scripts in this folder.

# Chip Orchestra should use the OpenAI-compatible provider path.
LLM_PROVIDER=glm
OPENAI_API_KEY=EMPTY

# Primary/default endpoint: R9700. Use this for full Chip Orchestra runs first.
OPENAI_BASE_URL=http://172.16.1.36:8005/v1
OPENAI_MODEL=R9700

# Secondary endpoint: Strix Halo. Recommended for lighter smoke tests, fallback,
# or smaller/quantized models unless /v1/models reports the same production model.
STRIX_HALO_OPENAI_BASE_URL=http://172.16.1.10:10000/v1
STRIX_HALO_OPENAI_MODEL=Strix-Halo

# Convenience aliases used by scripts/check_amd_infra_models.sh.
AMD_LLM_ENDPOINTS="R9700=http://172.16.1.36:8005/v1 Strix-Halo=http://172.16.1.10:10000/v1"

# The model id sent by Chip Orchestra must match one id returned by
# ${OPENAI_BASE_URL}/models, unless the server accepts aliases.
# Verify with:
#   bash deploy/selfhosted-llm-rocm/scripts/check_amd_infra_models.sh
